# Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# System Operating Mode: 'simulation' | 'real'
MODE=simulation

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AWS Cloud Settings (Optional for offline simulation fallback)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_SENSORS=floodguard_sensor_readings
DYNAMODB_TABLE_ZONES=floodguard_zones
S3_BUCKET_MODELS=floodguard-models-bucket

# Hydrological & Flood Risk Engine Defaults
WATER_RISE_THRESHOLD_CM=5.0
CRITICAL_WATER_DEPTH_CM=90.0
HIGH_WATER_DEPTH_CM=70.0
MODERATE_WATER_DEPTH_CM=50.0
